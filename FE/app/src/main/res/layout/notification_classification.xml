<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 상단: 앱 아이콘 + 앱 이름 + 시간 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="7iTAX" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="7ITAX"
            android:textSize="12sp"
            android:textColor="#666666"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="지금"
            android:textSize="12sp"
            android:textColor="#999999" />
    </LinearLayout>

    <!-- 제목: 💳 결제가 확인되었어요 -->
    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="💳 결제가 확인되었어요"
        android:textSize="15sp"
        android:textColor="#1A1A1A"
        android:textStyle="bold" />

    <!-- 가맹점 · 금액 -->
    <TextView
        android:id="@+id/notification_merchant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="스타벅스 강남점 · 5,500원"
        android:textSize="13sp"
        android:textColor="#343434" />

    <!-- AI 추천 세목 -->
    <TextView
        android:id="@+id/notification_ai_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="AI 추천 세목: 복리후생비 (신뢰도 87%)"
        android:textSize="13sp"
        android:textColor="#5655B9" />

    <!-- 안내 문구 -->
    <TextView
        android:id="@+id/notification_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="탭하여 세목을 확인해주세요"
        android:textSize="11sp"
        android:textColor="#AAAAAA" />

</LinearLayout>
