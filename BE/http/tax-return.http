### 세금 신고서 생성
POST {{baseUrl}}/tax/returns
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "taxYear": 2025,
  "prepaidTax": 500000,
  "deductions": {
    "국민연금": 1200000,
    "건강보험": 800000
  }
}

### 세금 신고서 목록 조회
GET {{baseUrl}}/tax/returns
Authorization: Bearer {{accessToken}}

### 세금 신고서 상세 조회
GET {{baseUrl}}/tax/returns/1
Authorization: Bearer {{accessToken}}

### 세금 신고서 수정
PUT {{baseUrl}}/tax/returns/1
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "prepaidTax": 600000,
  "deductions": {
    "국민연금": 1200000,
    "건강보험": 800000,
    "개인연금": 4000000
  }
}

### 세금 신고서 제출
POST {{baseUrl}}/tax/returns/1/submit
Authorization: Bearer {{accessToken}}

### 납부 상태 조회
GET {{baseUrl}}/tax/returns/1/payment-status
Authorization: Bearer {{accessToken}}

### 세금 납부
POST {{baseUrl}}/tax/returns/1/pay
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "cardId": 1
}

### 지방세 납부
POST {{baseUrl}}/tax/returns/1/pay-local
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "cardId": 1
}

### 신고서 PDF 다운로드
GET {{baseUrl}}/tax/returns/1/pdf
Authorization: Bearer {{accessToken}}

### 납부 영수증 다운로드
GET {{baseUrl}}/tax/returns/1/receipt
Authorization: Bearer {{accessToken}}
