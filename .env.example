# 필수 시크릿 — 로컬용 생성 예: openssl rand -base64 32 / openssl rand -base64 48
AES_ENCRYPTION_KEY=
JWT_SECRET=

# 인프라
REDIS_PASSWORD=ssafy
# 호스트에 PostgreSQL이 이미 떠 있어 5432가 충돌하면 바꾼다(bootRun은 DB_PORT도 같은 값으로)
POSTGRES_HOST_PORT=5432

# 환경별 스위치 — 값은 로컬·성능측정 기준. 주석은 값과 같은 줄에 두지 않는다(파서에 따라 값에 섞임)
# 운영: false
TEST_LOGIN_ENABLED=true
# 운영: false
APP_SEED_ENABLED=true
# 인스턴스 2대 이상이면 1대만 true
APP_SCHEDULING_ENABLED=true
# BE 단독 성능 측정(AI 서버 제외) 시 true
AI_MOCK_ENABLED=false
# BE→AI 챗봇 응답 대기(초). Opus 답변은 30~90초
AI_READ_TIMEOUT=120
# Flyway 도입 후 validate
JPA_DDL_AUTO=update
DB_POOL_MAX=10

# AI 서버
ANTHROPIC_API_KEY=

# 선택
CORS_ALLOWED_ORIGINS=http://localhost:3000
FCM_ENABLED=false
